{
  "name": "TraceFence",
  "problem": "After a tool timeout, replaying an agent trace can repeat writes whose outcome is uncertain. Engineers need an inspectable replay decision without uploading private traces.",
  "user": "Engineers debugging agent tools and retry behavior",
  "standout": {
    "name": "Replay fence",
    "description": "Turn a tool-call trace into an explained replay plan: replay declared reads, skip completed writes, and hold uncertain writes and key conflicts for review."
  },
  "demo_steps": [
    "Load the trace sample",
    "See the completed and uncertain writes",
    "Reveal an explained replay plan that schedules no writes"
  ],
  "kind": "web",
  "ai": false,
  "sample_data": [
    {
      "id": "read-1",
      "tool": "crm.lookup",
      "effect": "read",
      "status": "succeeded",
      "arguments": {
        "customer": "demo-17"
      }
    },
    {
      "id": "write-done",
      "tool": "ticket.update",
      "effect": "write",
      "status": "succeeded",
      "arguments": {
        "ticket": "demo-42",
        "state": "invoiced"
      },
      "idempotency_key": "ticket-42"
    },
    {
      "id": "write-1",
      "tool": "invoice.create",
      "effect": "write",
      "status": "succeeded",
      "arguments": {
        "customer": "demo-17",
        "amount": 125
      },
      "idempotency_key": "invoice-17"
    },
    {
      "id": "retry-1",
      "tool": "invoice.create",
      "effect": "write",
      "status": "timeout",
      "arguments": {
        "amount": 125,
        "customer": "demo-17"
      },
      "idempotency_key": "invoice-17"
    },
    {
      "id": "write-2",
      "tool": "message.send",
      "effect": "write",
      "status": "timeout",
      "arguments": {
        "recipient": "demo-user",
        "message": "Your invoice is ready"
      }
    },
    {
      "id": "retry-2",
      "tool": "message.send",
      "effect": "write",
      "status": "failed",
      "arguments": {
        "message": "Your invoice is ready",
        "recipient": "demo-user"
      }
    },
    {
      "id": "conflict-1",
      "tool": "invoice.create",
      "effect": "write",
      "status": "failed",
      "arguments": {
        "customer": "demo-17",
        "amount": 250
      },
      "idempotency_key": "invoice-17"
    }
  ],
  "prior_art": {
    "decision": "new",
    "references": [
      "https://github.com/Shibukedang27/agentlens-trace-analyzer",
      "https://github.com/kbipul/agent-scratchpad",
      "https://github.com/langchain-ai/langgraph/issues/9001",
      "https://github.com/langchain-ai/langgraph/issues/7138",
      "https://github.com/langchain-ai/langgraph/issues/9240",
      "https://github.com/langchain-ai/langgraph/issues/8464"
    ],
    "rationale": "Existing analyzers cover loops, cost and trace replay. This narrow deterministic inspector focuses on write uncertainty, completed-write skip decisions and idempotency-key conflicts, entirely browser-local. It is not a full observability replacement."
  }
}
